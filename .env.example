# 复制为 .env 后填写真实凭证，切勿把 .env 提交到公开仓库。
# 未配置的平台会显示为“未启用”，不会假装已采集到数据。

# Reddit 官方 OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3（默认配额每天 10,000 units）
YOUTUBE_API_KEY=

# X API v2 Bearer Token（按付费套餐计费）
X_BEARER_TOKEN=

# TikTok：需要官方授权数据接口，当前版本不提供绕过访问限制的采集方式
# TIKTOK_ACCESS_TOKEN=
